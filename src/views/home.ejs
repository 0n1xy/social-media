<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Social Media - Home</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      /* Custom scrollbar hiding (optional) */
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }

      /* Modal overlay */
      .modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.8);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 50;
      }

      .modal.active {
        display: flex;
      }

      .modal-content {
        width: 300px;
        height: 500px;
        background-color: white;
        border-radius: 10px;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
      }

      .close-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        cursor: pointer;
        font-size: 20px;
        font-weight: bold;
        color: gray;
      }
    </style>
  </head>
  <body class="bg-gray-100 text-gray-800">
    <!-- Header -->
    <header class="bg-blue-600 text-white shadow">
      <nav
        class="container mx-auto px-6 py-4 flex justify-between items-center"
      >
        <h1 class="text-xl font-bold">Social Media</h1>
        <ul class="flex space-x-6">
          <li><a href="/" class="hover:underline">Home</a></li>
          <li><a href="/explore" class="hover:underline">Explore</a></li>
          <li>
            <a href="/notifications" class="hover:underline">Notifications</a>
          </li>
          <li><a href="/logout" class="hover:underline">Logout</a></li>
        </ul>
      </nav>
    </header>

    <!-- Main Content -->
    <div class="container mx-auto flex mt-6 space-x-6">
      <!-- Sidebar -->
      <aside class="w-1/4 bg-white rounded-lg shadow p-6">
        <h2 class="text-xl font-semibold mb-4">
          Welcome, <%= user.username %>!
        </h2>
        <ul class="space-y-3">
          <li>
            <a href="/profile" class="text-blue-600 hover:underline"
              >My Profile</a
            >
          </li>
          <li>
            <a href="/friends" class="text-blue-600 hover:underline">Friends</a>
          </li>
          <li>
            <a href="/messages" class="text-blue-600 hover:underline"
              >Messages</a
            >
          </li>
          <li>
            <a href="/settings" class="text-blue-600 hover:underline"
              >Settings</a
            >
          </li>
        </ul>
      </aside>

      <!-- Feed -->
      <main class="w-3/4 bg-white rounded-lg shadow p-6">
        <!-- Stories Section -->
        <div class="mb-6">
          <h2 class="text-lg font-bold mb-4">Stories</h2>
          <div class="flex space-x-4 overflow-x-auto scrollbar-hide">
            <!-- Story 1 -->
            <div
              class="flex-none w-24 cursor-pointer"
              onclick="openStory('Story 1', 'https://via.placeholder.com/300x500')"
            >
              <img
                src="https://via.placeholder.com/80"
                alt="Story 1"
                class="w-20 h-20 rounded-full border-4 border-blue-500 mx-auto"
              />
              <p class="text-center text-sm mt-2 font-medium">Story 1</p>
            </div>
            <!-- Story 2 -->
            <div
              class="flex-none w-24 cursor-pointer"
              onclick="openStory('Story 2', 'https://via.placeholder.com/300x500')"
            >
              <img
                src="https://via.placeholder.com/80"
                alt="Story 2"
                class="w-20 h-20 rounded-full mx-auto"
              />
              <p class="text-center text-sm mt-2 font-medium">Story 2</p>
            </div>
          </div>
        </div>

        <!-- Posts Section -->
        <h1 class="text-2xl font-bold mb-6">Latest Posts</h1>
        <% if (posts && posts.length > 0) { %> <% posts.forEach(post => { %>
        <div class="mb-6">
          <h2 class="text-lg font-semibold text-gray-700"><%= post.title %></h2>
          <p class="text-gray-600 mt-2"><%= post.content %></p>
          <div
            class="flex items-center justify-between text-sm text-gray-500 mt-4"
          >
            <span>Posted by <%= post.author %></span>
            <span><%= post.date %></span>
          </div>
        </div>
        <% }) %> <% } else { %>
        <p class="text-gray-500">No posts to display.</p>
        <% } %>
      </main>
    </div>

    <!-- Story Modal -->
    <div id="storyModal" class="modal">
      <div class="modal-content">
        <span class="close-btn" onclick="closeStory()">&times;</span>
        <img
          id="storyImage"
          src=""
          alt="Story"
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white text-center py-4 mt-6">
      <p>
        &copy; <%= new Date().getFullYear() %> Social Media App. All rights
        reserved.
      </p>
    </footer>

    <script>
      // Open story modal
      function openStory(title, imageUrl) {
        const modal = document.getElementById("storyModal");
        const storyImage = document.getElementById("storyImage");
        storyImage.src = imageUrl;
        modal.classList.add("active");
      }

      // Close story modal
      function closeStory() {
        const modal = document.getElementById("storyModal");
        modal.classList.remove("active");
      }
    </script>
  </body>
</html>
